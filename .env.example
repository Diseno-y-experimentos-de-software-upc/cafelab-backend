# Copiar a .env y ajustar. Para arranque local con MySQL en la máquina:
# SPRING_PROFILES_ACTIVE=dev
#
# Antes de probar o presentar (esquema lo crea Hibernate al arrancar el backend):
#   mysql -u root -p -e "DROP DATABASE IF EXISTS cafe; CREATE DATABASE cafe;"
# Por defecto (perfil dev) ya se usa: host localhost, puerto 3306, base cafe, user root, password root.
# Solo define estas variables si tu MySQL local es distinto:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cafe
# DB_USERNAME=root
# DB_PASSWORD=root
#
# JWT_SECRET=opcional-en-dev-si-quieres-rotar-el-secreto-local
